{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parametric-font-lab.local/schema/project-3.json",
  "title": "PFL Sans Inter-derived project",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "engine", "axes", "activePreset"],
  "properties": {
    "schemaVersion": {"const": 3},
    "id": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z0-9-]+$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 100},
    "engine": {"const": {"id": "inter-derived", "version": "3.0"}},
    "axes": {"type": "object", "additionalProperties": false, "required": ["weight", "opticalSize"], "properties": {"weight": {"type": "number", "minimum": 100, "maximum": 900}, "opticalSize": {"type": "number", "minimum": 14, "maximum": 32}}},
    "activePreset": {"enum": ["text", "display", "custom"]}
  }
}
